{
  "sort directive": {
    "prefix": "sort",
    "body": [
      "{**sort**}$0",
      "{**endsort**}"
    ]
  },
  "sort use directive": {
    "prefix": "sortuse",
    "body": [
      "{**sortuse**}$0",
      "{**endsortuse**}"
    ]
  },
  "ifdef directive": {
    "prefix": "ifdef",
    "body": [
        "{\\$IFDEF $1}$0",
        "{\\$ENDIF}"
    ]
  },
  "ifndef directive": {
    "prefix": "ifndef",
    "body": [
      "{\\$IFNDEF $1}$0",
      "{\\$ENDIF}"
    ]
  },
  "linux directive": {
    "prefix": "linux",
    "body": [
      "{\\$IFDEF LINUX}$0",
      "{\\$ENDIF}"
    ]
  },
  "windows directive": {
    "prefix": "windows",
    "body": [
      "{\\$IFDEF WIN64}$0",
      "{\\$ENDIF}"
    ]
  },
  "headless directive": {
    "prefix": "headless",
    "body": [
      "{\\$IFDEF HEADLESS}$0",
      "{\\$ENDIF}"
    ]
  },
  "begin end": {
    "prefix": "begin",
    "body": [
      "begin",
      "$0",
      "end;"
    ]
  },
  "unit skeleton": {
    "prefix": "unit",
    "body": [
      "unit ${TM_FILENAME_BASE};",
      "",
      "interface",
      "  $0",
      "implementation",
      "",
      "end."
    ]
  },
  "if": {
    "prefix": "if",
    "body": [
      "if ${1:condition} then",
      "  begin",
      "  $0",
      "  end;"
    ]
  },
  "case": {
    "prefix": "case",
    "body": [
      "case $1 of",
      "$2 :",
      "  begin",
      "  $3",
      "  end;",
      "$4 :",
      "  begin",
      "  $5",
      "  end;",
      "else",
      "  begin",
      "  $0",
      "  end;"
    ]
  },
  "procedure": {
    "prefix": "procedure",
    "body": [
      "procedure $1;",
      "begin",
      "$0",
      "end;"
    ]
  },
  "function": {
    "prefix": "function",
    "body": [
      "function $1;",
      "begin",
      "$0",
      "end;"
    ]
  }
}
